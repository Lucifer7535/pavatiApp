# =============================================================================
# Pāvati Pustak — API Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# See env-vars-guide.md for detailed instructions on obtaining each value.
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://pavati:your_password@localhost:5432/pavati?schema=public"

# --- Authentication ---
JWT_SECRET="your-256-bit-random-secret"
JWT_EXPIRES_IN="7d"
REFRESH_SECRET="your-256-bit-refresh-secret"

# --- Server ---
PORT=4000
WEB_ORIGIN="http://localhost:5173"
PUBLIC_BASE_URL="http://localhost:4000"

# --- File Storage ---
UPLOAD_DIR="./uploads"
# Set to "r2" for Cloudflare R2, or "disk" for local storage (default: auto-detect)
# STORAGE_DRIVER="disk"

# --- Cloudflare R2 (optional — leave blank to use local disk storage) ---
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-bucket-name"
# R2_PUBLIC_URL="https://your-bucket.your-r2-domain.com"

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# --- Resend Email (optional — email notifications won't work without this) ---
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="no-reply@yourdomain.com"

# --- Mock Mode ---
# Set to "true" to use mock payment providers (useful for local development)
MOCK_MODE="false"
