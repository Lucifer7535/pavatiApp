  "layerMap": {
    "layer:api": {
      "id": "layer:api",
      "name": "API Server",
      "description": "Express REST API implementation: entry point, config, shared lib utilities (email, HTTP, JWT, session, logger, Prisma), request middleware (auth, error, rate limit, RBAC, validation), 13 route modules (auth, trusts, members, donations, templates, receipts, campaigns, announcements, notifications, reports, users, uploads, dashboard), external providers (messaging, storage), and business services (audit, notifications, receipts PDF)."
    },
    "layer:api-data": {
      "id": "layer:api-data",
      "name": "API Data Layer",
      "description": "Persistence layer for the API: Prisma schema (domain model with 12 enums and 18 models), PostgreSQL migration history, migration lock, and the seed script that creates the production admin user."
    },
    "layer:api-config": {
      "id": "layer:api-config",
      "name": "API Configuration",
      "description": "Build and package configuration for the API workspace: npm package manifest (dependencies, scripts) and TypeScript compiler configuration extending the root base."
    },
    "layer:web-ui": {
      "id": "layer:web-ui",
      "name": "Web UI (React Application)",
      "description": "React 19 application screens: 17 feature directories (auth, donations, receipts, templates, members, campaigns, reports, dashboard, announcements, notifications, onboarding, settings, audit, donate, landing, account, trust) plus 7 shared components (ui kit, layout, logo, festival picker, receipt preview, template field overlay, logout button)."
    },
    "layer:web-core": {
      "id": "layer:web-core",
      "name": "Web Core (Application Shell)",
      "description": "Web application bootstrap and infrastructure shell: React entry point (main.tsx), central router with auth/membership/permission guards, i18n system, shared lib layer (HTTP API client, auth actions, festival helpers, Zustand stores, utils), the SPA HTML shell, global Tailwind styles, and PWA manifest."
    },
    "layer:web-config": {
      "id": "layer:web-config",
      "name": "Web Configuration",
      "description": "Build and package configuration for the web workspace: npm package manifest, TypeScript compiler configuration, Vite build/dev-server config with API proxy, and incremental build info cache."
    },
    "layer:shared": {
      "id": "layer:shared",
      "name": "Shared Package",
      "description": "@pavati/shared workspace package consumed by both API and web: domain type definitions, Zod validation schemas, RBAC permissions map, constants/enums, shared utilities (INR/date formatting), the public barrel, and its package/tsconfig config."
    },
    "layer:receipt-engine": {
      "id": "layer:receipt-engine",
      "name": "Receipt Engine",
      "description": "@pavati/receipt-engine workspace package producing donation receipt PDFs: layout engine (DrawOp generation), Node-side pdf-lib PDF renderer (Devanagari-aware, embedded images), browser-side Canvas renderer, font management, type definitions, client and server barrels, build script, and package/tsconfig config."
    },
    "layer:config-root": {
      "id": "layer:config-root",
      "name": "Root & Tooling Configuration",
      "description": "Monorepo root and tooling files: root npm workspaces manifest, shared tsconfig.base.json, Heroku Procfile, deployment plan documentation, and analysis-tool configuration and outputs."
    },
    "layer:test": {
      "id": "layer:test",
      "name": "Tests",
      "description": "Test suites across the monorepo: API integration and unit tests (app smoke test, Google OAuth, WhatsApp notifications, permission/RBAC, Zod schema validation) and receipt-engine layout unit tests, all run with Vitest."
    }
  }
